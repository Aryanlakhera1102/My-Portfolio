/* hybrid */
.hybrid-eq{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:60px;}
.hybrid-box{
  flex:1;min-width:220px;border:3px solid var(--line);padding:34px 28px;border-radius:var(--radius);
  box-shadow:0 6px 0 rgba(0,0,0,0.25);transition:transform .3s var(--pop);
}
.hybrid-box:hover{transform:translateY(-4px);}
.hybrid-box h4{font-family:'Space Grotesk';font-size:18px;margin-bottom:10px;}
.hybrid-box p{color:var(--text-dim);font-size:13.5px;line-height:1.6;}
.eq-sign{font-family:'Space Grotesk';font-size:26px;color:var(--muted);}
.hybrid-result{
  flex:1;min-width:220px;border:3px solid var(--accent);padding:34px 28px;border-radius:var(--radius);
  background:rgba(255,77,141,0.1);box-shadow:0 6px 0 var(--accent-dark);
}
.hybrid-result h4{color:var(--accent);}

/* resume */
.resume-panel{
  display:flex;justify-content:space-between;align-items:center;border:3px solid var(--accent-3);
