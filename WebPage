/* ---------- three.js floating object ---------- */
if(!reduceMotion && window.THREE){
  const canvas = document.getElementById('three-canvas');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(45, canvas.clientWidth/canvas.clientHeight || 1, 0.1, 100);
  camera.position.z = 6;
  const renderer = new THREE.WebGLRenderer({canvas, alpha:true, antialias:true});
  function size(){
    const w = canvas.parentElement.clientWidth, h = canvas.parentElement.clientHeight;
    renderer.setSize(w,h); camera.aspect=w/h; camera.updateProjectionMatrix();
  }
  size();
  renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));

  function toonBlob(geo, color, pos, scale){
    const g = new THREE.Group();
    const mat = new THREE.MeshToonMaterial({color});
    const fill = new THREE.Mesh(geo, mat);
    const outlineMat = new THREE.MeshBasicMaterial({color:0x171233, side:THREE.BackSide});
    const outline = new THREE.Mesh(geo, outlineMat);
    outline.scale.multiplyScalar(1.06);
    const wire = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({color:0xffffff, wireframe:true, transparent:true, opacity:0.25}));
    g.add(outline, fill, wire);
    g.position.set(...pos);
    g.scale.setScalar(scale);
    scene.add(g);
    return g;
  }

  const mesh = toonBlob(new THREE.IcosahedronGeometry(1.5, 1), 0xff4d8d, [2.6,0.2,0], 1);
  const mesh2 = toonBlob(new THREE.TorusGeometry(0.5, 0.17, 10, 34), 0x22e3ff, [1.4,-1.2,0.5], 1);
  const mesh3 = toonBlob(new THREE.OctahedronGeometry(0.42, 0), 0xffd23f, [3.3,1.5,0.3], 1);
  const mesh4 = toonBlob(new THREE.IcosahedronGeometry(0.3, 0), 0x7cff5a, [1.9,1.7,0.6], 1);

  const light = new THREE.PointLight(0xffffff, 2.2);
  light.position.set(4,4,4);
  scene.add(light);
  const light2 = new THREE.PointLight(0xff4d8d, 1.2);
  light2.position.set(-2,-3,2);
  scene.add(light2);
  scene.add(new THREE.AmbientLight(0x4a3d8a, 1.4));

  let mx=0,my=0;
  window.addEventListener('mousemove',e=>{
    mx=(e.clientX/window.innerWidth-0.5); my=(e.clientY/window.innerHeight-0.5);
  });

  function animate(){
    requestAnimationFrame(animate);
    mesh.rotation.y += 0.0025;
    mesh.rotation.x += 0.001;
    mesh.rotation.y += (mx*0.3 - mesh.rotation.y*0.02)*0.02;
    mesh2.rotation.x += 0.004; mesh2.rotation.y += 0.003;
    mesh3.rotation.x -= 0.003; mesh3.rotation.y += 0.005;
    mesh4.rotation.x += 0.006; mesh4.rotation.y -= 0.004;
    renderer.render(scene,camera);
  }
  requestAnimationFrame(()=>{canvas.classList.add('ready'); animate();});
  window.addEventListener('resize', size);

  gsap.to(mesh.position,{y:-0.6, scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}});
  gsap.to(mesh2.position,{y:-1.6, x:0.9, scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}});
  gsap.to(mesh3.position,{y:2.4, scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}});

  /* playful idle bob */
  [mesh,mesh2,mesh3,mesh4].forEach((m,i)=>{
    gsap.to(m.position,{y:'+=0.25',duration:1.6+i*0.3,ease:'sine.inOut',yoyo:true,repeat:-1,delay:i*0.2});
  });
}

