<style>
:root{
  --bg:#171233;
  --surface:#1e1840;
  --surface-2:#291f52;
  --line:rgba(255,255,255,0.12);
  --text:#f6f3ff;
  --text-dim:#b9b0e8;
  --muted:#8477c2;
  --accent:#ff4d8d;
  --accent-dark:#c22e64;
  --accent-2:#22e3ff;
  --accent-2-dark:#0e9fb8;
  --accent-3:#ffd23f;
  --accent-3-dark:#d9a300;
  --accent-4:#7cff5a;
  --accent-4-dark:#3fbf1f;
  --silver:#c7c9cf;
  --radius:20px;
  --radius-sm:12px;
  --ease:cubic-bezier(.16,1,.3,1);
  --pop:cubic-bezier(.34,1.56,.64,1);
  --maxw:1360px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:auto;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Manrope',sans-serif;
  font-weight:400;
  overflow-x:hidden;
  cursor:none;
  -webkit-font-smoothing:antialiased;
}
@media (max-width:860px){ body{cursor:auto;} }
h1,h2,h3,h4,.display{
  font-family:'Space Grotesk',sans-serif;
  font-weight:500;
  letter-spacing:-0.02em;
  line-height:1.02;
}
a{color:inherit;text-decoration:none;}
img{max-width:100%;display:block;}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 40px;}
@media (max-width:700px){.wrap{padding:0 22px;}}
::selection{background:var(--accent);color:#0c0d10;}

.mesh-bg{
  position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.7;
  background:
    radial-gradient(650px 550px at 10% 6%, rgba(255,77,141,0.20), transparent 60%),
    radial-gradient(600px 520px at 90% 18%, rgba(34,227,255,0.16), transparent 60%),
    radial-gradient(560px 480px at 28% 88%, rgba(255,210,63,0.12), transparent 60%),
    radial-gradient(600px 500px at 80% 94%, rgba(124,255,90,0.12), transparent 60%);
}
.orb{position:absolute;border-radius:50%;filter:blur(55px);pointer-events:none;z-index:0;animation:orbfloat 7s ease-in-out infinite;}
.orb-1{width:360px;height:360px;background:radial-gradient(circle,rgba(255,77,141,0.55),transparent 70%);top:-100px;left:-80px;}
.orb-2{width:280px;height:280px;background:radial-gradient(circle,rgba(34,227,255,0.45),transparent 70%);bottom:-60px;right:6%;animation-delay:-2s;}
.orb-3{width:220px;height:220px;background:radial-gradient(circle,rgba(255,210,63,0.4),transparent 70%);top:40%;right:-40px;animation-delay:-4s;}
@keyframes orbfloat{0%,100%{transform:translateY(0) scale(1);}50%{transform:translateY(-24px) scale(1.06);}}

/* ---------- custom cursor ---------- */
#cursor{
  position:fixed;top:0;left:0;width:12px;height:12px;border-radius:50%;
  background:var(--accent);pointer-events:none;z-index:9999;
  transform:translate(-50%,-50%);
  box-shadow:0 0 10px var(--accent);
  transition:width .25s var(--pop),height .25s var(--pop),background .25s,opacity .2s;
}
#cursor.ring{
  width:58px;height:58px;background:rgba(255,77,141,0.08);
  border:2px solid var(--accent);box-shadow:0 0 20px rgba(255,77,141,0.5);
  display:flex;align-items:center;justify-content:center;
  font-size:10px;letter-spacing:.12em;font-family:'Space Grotesk',sans-serif;
}
@media (max-width:860px){#cursor{display:none;}}

/* ---------- loader ---------- */
#loader{
  position:fixed;inset:0;background:var(--bg);z-index:10000;
  display:flex;align-items:center;justify-content:center;
  transition:opacity .8s var(--ease), visibility .8s var(--ease);
}
#loader span{font-family:'Space Grotesk';font-size:13px;letter-spacing:.3em;color:var(--muted);}
#loader.hide{opacity:0;visibility:hidden;}

/* ---------- nav ---------- */
nav{
  position:fixed;top:22px;left:50%;transform:translateX(-50%);
  z-index:900;display:flex;align-items:center;gap:6px;
  background:rgba(30,24,64,0.72);backdrop-filter:blur(16px);
  border:2px solid var(--line);border-radius:100px;
  padding:8px 8px 8px 18px;
  box-shadow:0 6px 0 rgba(0,0,0,0.25);
  transition:padding .4s var(--ease), background .4s var(--ease);
}
nav.scrolled{padding:6px 6px 6px 16px;background:rgba(23,18,51,0.9);}
.nav-logo{font-family:'Space Grotesk';font-size:14px;font-weight:600;margin-right:10px;letter-spacing:-0.01em;}
.nav-links{display:flex;gap:2px;}
.nav-links a{
  font-size:12px;letter-spacing:.05em;color:var(--text-dim);
  padding:9px 14px;border-radius:100px;transition:color .3s,background .3s;
  position:relative;
}
.nav-links a:hover,.nav-links a.active{color:var(--text);background:var(--surface-2);}
@media (max-width:900px){.nav-links{display:none;}}
.nav-cta{
  font-size:12px;background:var(--accent);color:#1a0d16;padding:9px 16px;
  border-radius:100px;font-weight:700;margin-left:4px;border:2px solid var(--accent-dark);
  box-shadow:0 3px 0 var(--accent-dark);transition:transform .15s var(--pop),box-shadow .15s var(--pop);
}
.nav-cta:hover{transform:translateY(-2px);}
.nav-cta:active{transform:translateY(3px);box-shadow:0 0 0 var(--accent-dark);}
@media (max-width:900px){.nav-cta{display:none;}}
.hamburger{display:none;width:34px;height:34px;border-radius:50%;align-items:center;justify-content:center;}
@media (max-width:900px){.hamburger{display:flex;}}
.hamburger span{display:block;width:16px;height:1px;background:var(--text);position:relative;}
.hamburger span::before,.hamburger span::after{content:'';position:absolute;width:16px;height:1px;background:var(--text);left:0;}
.hamburger span::before{top:-5px;}.hamburger span::after{top:5px;}

#mobile-menu{
  position:fixed;inset:0;background:var(--bg);z-index:1000;
  display:flex;flex-direction:column;justify-content:center;padding:40px;
  transform:translateY(-100%);transition:transform .5s var(--ease);
}
#mobile-menu.open{transform:translateY(0);}
#mobile-menu a{font-family:'Space Grotesk';font-size:34px;padding:12px 0;border-bottom:1px solid var(--line);}
#mobile-menu .close{position:absolute;top:26px;right:26px;font-size:13px;letter-spacing:.1em;}

/* ---------- hero ---------- */
.hero{
  min-height:100vh;position:relative;display:flex;flex-direction:column;
  justify-content:center;padding:140px 0 80px;overflow:hidden;
}
.hero-grid{
  display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:end;
}
@media (max-width:960px){.hero-grid{grid-template-columns:1fr;}}
.eyebrow{
  font-size:11px;letter-spacing:.15em;color:var(--muted);
  display:flex;align-items:center;gap:10px;margin-bottom:26px;
}
.dot-live{width:6px;height:6px;border-radius:50%;background:#5cff9d;box-shadow:0 0 8px #5cff9d;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.35;}}
.hero h1{
  font-size:clamp(42px,7.4vw,108px);
  color:var(--text);
}
.hero h1 .grad{
  background:linear-gradient(100deg,var(--accent),var(--accent-2) 55%,var(--accent-3));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero h1 .line{overflow:hidden;display:block;}
.hero h1 .line span{display:block;will-change:transform,filter;}
.hero-sub{
  max-width:420px;color:var(--text-dim);font-size:16px;line-height:1.6;margin-top:26px;
}
.hero-meta{
  display:flex;gap:28px;margin-top:34px;flex-wrap:wrap;
}
.hero-meta div{font-size:12px;color:var(--muted);letter-spacing:.05em;}
.hero-meta strong{display:block;color:var(--text);font-family:'Space Grotesk';font-size:14px;font-weight:500;margin-bottom:4px;}

.hero-photo-col{position:relative;display:flex;justify-content:flex-end;}
.hero-photo{
  width:100%;max-width:340px;aspect-ratio:3/4;position:relative;
  border-radius:var(--radius);overflow:hidden;
  background:linear-gradient(160deg,#2a2160,#171233 70%);
  border:3px solid var(--accent);
  box-shadow:0 10px 0 var(--accent-dark), 0 10px 30px rgba(0,0,0,0.4);
  transform-style:preserve-3d;
}
.hero-photo::before{
  content:'AL';position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-family:'Space Grotesk';font-size:110px;font-weight:600;color:rgba(244,243,240,0.05);
}
.hero-photo .ph-label{
  position:absolute;bottom:14px;left:14px;right:14px;font-size:10px;letter-spacing:.08em;
  color:var(--muted);border-top:1px solid var(--line);padding-top:10px;
}
.hero-photo .scan{position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(255,255,255,0.02) 0px,rgba(255,255,255,0.02) 1px,transparent 1px,transparent 3px);pointer-events:none;}
.hero-photo .glow{position:absolute;width:220px;height:220px;background:radial-gradient(circle,rgba(79,124,255,0.35),transparent 70%);filter:blur(20px);top:-40px;right:-60px;}

.scroll-cue{
  position:absolute;bottom:36px;left:40px;display:flex;align-items:center;gap:10px;
  font-size:11px;letter-spacing:.1em;color:var(--muted);
}
@media (max-width:700px){.scroll-cue{left:22px;}}
.scroll-cue .bar{width:1px;height:34px;background:var(--line);position:relative;overflow:hidden;}
.scroll-cue .bar::after{content:'';position:absolute;top:-40%;left:0;width:100%;height:40%;background:var(--text);animation:scrollmove 1.8s infinite var(--ease);}
@keyframes scrollmove{0%{top:-40%;}100%{top:100%;}}

#three-canvas{position:absolute;top:0;right:0;width:100%;height:100%;pointer-events:none;opacity:0;transition:opacity 1.2s ease;}
#three-canvas.ready{opacity:1;}

/* ---------- section basics ---------- */
section{position:relative;padding:150px 0;}
@media (max-width:700px){section{padding:100px 0;}}
.label-sm{font-size:11px;letter-spacing:.15em;color:var(--muted);margin-bottom:20px;display:block;}
.section-head{max-width:760px;margin-bottom:70px;}
.section-head h2{font-size:clamp(30px,4.4vw,58px);}
.reveal-word{display:inline-block;overflow:hidden;}
.reveal-word span{display:inline-block;will-change:transform;}

/* statement */
.statement{padding:120px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
.statement h2{
  font-size:clamp(28px,5.6vw,74px);max-width:1100px;color:var(--text);
}
.statement p{max-width:520px;color:var(--text-dim);margin-top:34px;font-size:16px;line-height:1.7;}

/* about */
.about-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px;align-items:start;}
@media (max-width:860px){.about-grid{grid-template-columns:1fr;gap:40px;}}
.about-photo{
  aspect-ratio:4/5;border-radius:var(--radius);border:3px solid var(--accent-2);
  box-shadow:0 8px 0 var(--accent-2-dark);
  background:linear-gradient(150deg,#1e1840,#171233);position:relative;overflow:hidden;
}
.about-photo::before{content:'PHOTO PLACEHOLDER';position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:11px;letter-spacing:.1em;color:var(--muted);}
.about-text p{color:var(--text-dim);font-size:18px;line-height:1.75;max-width:600px;margin-bottom:22px;}
.about-text p strong{color:var(--text);font-weight:600;}
.stat-row{display:flex;gap:50px;margin-top:50px;flex-wrap:wrap;}
.stat{}
.stat .num{font-family:'Space Grotesk';font-size:44px;font-weight:600;color:var(--text);}
.stat .cap{font-size:11px;letter-spacing:.08em;color:var(--muted);margin-top:6px;max-width:180px;}

/* enjoy cards */
.enjoy-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
@media (max-width:860px){.enjoy-grid{grid-template-columns:repeat(2,1fr);}}
.enjoy-card{background:var(--bg);padding:34px 24px;min-height:150px;display:flex;align-items:flex-end;transition:background .3s,transform .3s;}
.enjoy-card:nth-child(4n+1):hover{background:rgba(255,77,141,0.14);transform:translateY(-4px) rotate(-1deg);}
.enjoy-card:nth-child(4n+2):hover{background:rgba(34,227,255,0.14);transform:translateY(-4px) rotate(1deg);}
.enjoy-card:nth-child(4n+3):hover{background:rgba(255,210,63,0.14);transform:translateY(-4px) rotate(-1deg);}
.enjoy-card:nth-child(4n+4):hover{background:rgba(124,255,90,0.14);transform:translateY(-4px) rotate(1deg);}
.enjoy-card span{font-family:'Space Grotesk';font-size:17px;}

/* services */
.service-row{border-top:1px solid var(--line);padding:34px 0;cursor:pointer;}
.service-row:last-child{border-bottom:1px solid var(--line);}
.service-top{display:flex;align-items:center;gap:28px;}
.service-num{font-family:'Space Grotesk';font-size:13px;color:var(--muted);width:30px;}
.service-name{font-family:'Space Grotesk';font-size:clamp(20px,2.6vw,30px);flex:1;transition:color .3s,transform .3s;}
.service-row:hover .service-name{color:var(--accent);transform:translateX(6px);}
.service-row:nth-child(3n+2):hover .service-name{color:var(--accent-2);}
.service-row:nth-child(3n+3):hover .service-name{color:var(--accent-3);}
.service-arrow{font-size:18px;color:var(--muted);transition:transform .4s var(--ease);}
.service-row.open .service-arrow{transform:rotate(45deg);}
.service-body{max-height:0;overflow:hidden;transition:max-height .5s var(--ease);}
.service-row.open .service-body{max-height:120px;}
.service-body p{color:var(--text-dim);font-size:14px;max-width:560px;padding:16px 0 0 58px;line-height:1.6;}

/* skills */
.skills-tier{margin-bottom:54px;}
.tier-label{font-size:11px;letter-spacing:.12em;color:var(--muted);margin-bottom:18px;display:block;}
.tag-cloud{display:flex;flex-wrap:wrap;gap:10px;}
.tag{
  border:2px solid var(--line);padding:10px 18px;border-radius:100px;font-size:13px;
  color:var(--text-dim);transition:transform .25s var(--pop),border-color .25s,color .25s,background .25s;
}
.tag:hover{transform:translateY(-3px) scale(1.05);}
.tier-1 .tag{color:var(--text);font-size:15px;padding:12px 20px;border-width:2px;}
.tag:hover{border-color:var(--accent);color:var(--text);background:rgba(79,124,255,0.08);}
.tag:nth-child(3n+2):hover{border-color:var(--accent-2);background:rgba(138,124,255,0.1);}
.tag:nth-child(4n+3):hover{border-color:var(--accent-3);background:rgba(255,138,92,0.1);}
.tag:nth-child(5n+4):hover{border-color:var(--accent-4);background:rgba(61,220,151,0.1);}

/* work */
.project-card{
  border-top:1px solid var(--line);padding:50px 0;display:grid;grid-template-columns:.9fr 1.1fr;gap:50px;align-items:center;
}
.project-card:last-child{border-bottom:1px solid var(--line);}
@media (max-width:860px){.project-card{grid-template-columns:1fr;gap:24px;}}
.project-thumb{
  aspect-ratio:16/10;border-radius:var(--radius);position:relative;overflow:hidden;
  border:3px solid var(--line);box-shadow:0 6px 0 rgba(0,0,0,0.3);
  transition:border-color .3s,transform .3s;
}
.project-card:hover .project-thumb{border-color:var(--accent);}
.project-thumb .bg{position:absolute;inset:0;}
.project-thumb .initial{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk';font-size:14px;letter-spacing:.1em;color:rgba(244,243,240,0.55);}
.project-info .cat{font-size:11px;letter-spacing:.1em;color:var(--muted);margin-bottom:12px;}
.project-info h3{font-family:'Space Grotesk';font-size:clamp(24px,3vw,36px);margin-bottom:14px;}
.project-info p{color:var(--text-dim);font-size:14.5px;line-height:1.6;max-width:460px;margin-bottom:18px;}
.tech-tags{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;}
.tech-tags span{font-size:11px;color:var(--muted);border:1px solid var(--line);padding:5px 10px;border-radius:100px;}
.project-link{font-size:12px;letter-spacing:.05em;border-bottom:1px solid var(--text-dim);padding-bottom:3px;}

/* gallery */
.masonry{columns:4 220px;column-gap:14px;}
@media (max-width:700px){.masonry{columns:2 150px;}}
.masonry-item{break-inside:avoid;margin-bottom:14px;border-radius:var(--radius-sm);overflow:hidden;border:3px solid var(--line);position:relative;background:var(--surface);cursor:pointer;transition:border-color .3s,transform .3s;}
.masonry-item:nth-child(4n+1):hover{border-color:var(--accent);transform:rotate(-1deg) scale(1.02);}
.masonry-item:nth-child(4n+2):hover{border-color:var(--accent-2);transform:rotate(1deg) scale(1.02);}
.masonry-item:nth-child(4n+3):hover{border-color:var(--accent-3);transform:rotate(-1deg) scale(1.02);}
.masonry-item:nth-child(4n+4):hover{border-color:var(--accent-4);transform:rotate(1deg) scale(1.02);}
.masonry-item img{width:100%;display:block;transition:transform .6s var(--ease),filter .4s;}
.masonry-item:hover img{transform:scale(1.06);}
.masonry-item .tag-chip{position:absolute;bottom:10px;left:10px;font-size:10px;letter-spacing:.08em;background:rgba(12,13,16,0.75);backdrop-filter:blur(6px);padding:5px 10px;border-radius:100px;color:var(--text-dim);opacity:0;transition:opacity .3s;}
.masonry-item:hover .tag-chip{opacity:1;}
#lightbox{position:fixed;inset:0;background:rgba(8,9,11,0.92);backdrop-filter:blur(6px);z-index:2000;display:none;align-items:center;justify-content:center;padding:40px;}
#lightbox.open{display:flex;}
#lightbox img{max-width:min(900px,90vw);max-height:85vh;border-radius:var(--radius);border:1px solid var(--line);}
#lightbox .lb-close{position:absolute;top:26px;right:30px;font-size:13px;letter-spacing:.1em;color:var(--text-dim);}

/* click nexa */
.nexa{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
.nexa-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;}
@media (max-width:860px){.nexa-grid{grid-template-columns:1fr;}}
.nexa h2{font-size:clamp(30px,4.6vw,56px);margin-bottom:26px;}
.nexa p{color:var(--text-dim);font-size:16px;line-height:1.7;margin-bottom:26px;max-width:480px;}
.nexa-list{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:34px;}
.nexa-list span{font-size:12px;border:1px solid var(--line);padding:8px 14px;border-radius:100px;color:var(--text-dim);}
.btn{
  display:inline-flex;align-items:center;gap:10px;font-size:13px;letter-spacing:.04em;
  padding:15px 28px;border:2px solid var(--text);border-radius:100px;font-weight:700;
  background:var(--surface);color:var(--text);
  box-shadow:0 5px 0 var(--line);
  transition:transform .15s var(--pop),box-shadow .15s var(--pop),background .25s,color .25s,border-color .25s;
  position:relative;top:0;
}
.btn:hover{transform:translateY(-2px);}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 var(--line);}
.btn.solid{background:var(--accent);color:#1a0d16;border-color:var(--accent-dark);box-shadow:0 5px 0 var(--accent-dark);}
.btn.solid:hover{background:#ff6da3;}
.btn.solid:active{box-shadow:0 1px 0 var(--accent-dark);}

/* timeline */
.timeline{position:relative;padding-left:36px;}
.timeline::before{content:'';position:absolute;left:6px;top:0;bottom:0;width:1px;background:var(--line);}
.timeline-fill{position:absolute;left:6px;top:0;width:1px;background:var(--accent);height:0;transition:height .1s;}
.tl-item{position:relative;padding-bottom:60px;}
.tl-item:last-child{padding-bottom:0;}
.tl-dot{position:absolute;left:-36px;top:4px;width:11px;height:11px;border-radius:50%;background:var(--bg);border:1px solid var(--muted);}
.tl-item.current .tl-dot{background:var(--accent);border-color:var(--accent);box-shadow:0 0 10px var(--accent);}
.tl-year{font-size:11px;letter-spacing:.1em;color:var(--muted);margin-bottom:10px;}
.tl-item h3{font-family:'Space Grotesk';font-size:26px;margin-bottom:6px;}
